// IA 4 - AUDIT LOG (SEGURANÃ‡A ENTERPRISE)
// ============================================

/// Tipo de aÃ§Ã£o auditada
enum AuditAction {
  CREATE // CriaÃ§Ã£o de registro
  UPDATE // AtualizaÃ§Ã£o de registro
  DELETE // ExclusÃ£o de registro
  READ // Leitura de registro
  LOGIN // Login de usuÃ¡rio
  LOGOUT // Logout de usuÃ¡rio
  SEARCH // Pesquisa de dados
  ACCESS // Acesso a recurso sensÃ­vel
  EXPORT // ExportaÃ§Ã£o de dados
  IMPORT // ImportaÃ§Ã£o de dados
  PUBLISH // PublicaÃ§Ã£o (ex: portais)
  REVOKE // RevogaÃ§Ã£o de acesso
  APPROVE // AprovaÃ§Ã£o
  REJECT // RejeiÃ§Ã£o
  SEND // Envio de mensagem
  RECEIVE // Recebimento de mensagem
  PASSWORD_CHANGE // AlteraÃ§Ã£o de senha
  SETTINGS_CHANGE // AlteraÃ§Ã£o de configuraÃ§Ãµes
}

/// Entidade auditada
enum AuditEntity {
  USER // UsuÃ¡rio
  ORGANIZATION // OrganizaÃ§Ã£o
  PROPERTY // ImÃ³vel
  LEAD // Lead
  OWNER // ProprietÃ¡rio
  CONVERSATION // Conversa
  ANNOUNCEMENT // AnÃºncio
  PACKAGE // Pacote
  SUBSCRIPTION // Assinatura
  PAYMENT // Pagamento
  NOTIFICATION // NotificaÃ§Ã£o
}

/// NÃ­vel de risco da aÃ§Ã£o
enum AuditRiskLevel {
  LOW // Baixo risco
  MEDIUM // MÃ©dio risco
  HIGH // Alto risco
  CRITICAL // Risco crÃ­tico
}

/// Modelo de Auditoria (AuditLog)
model AuditLog {
  id String @id @default(cuid())

  // IdentificaÃ§Ã£o da aÃ§Ã£o
  action     AuditAction // Tipo de aÃ§Ã£o realizada
  entityType String? // Tipo da entidade afetada (Property, Lead, User)
  entityId   String? // ID do registro afetado

  // Dados da aÃ§Ã£o
  beforeValues Json? // Estado anterior
  afterValues  Json? // Estado posterior
  diff         Json? // DiferenÃ§a entre estados
  metadata     Json? // Metadados adicionais
  description  String? // DescriÃ§Ã£o da aÃ§Ã£o

  // Contexto de seguranÃ§a
  ipAddress String? // EndereÃ§o IP do usuÃ¡rio
  userAgent String? // User Agent do navegador
  sessionId String? // ID da sessÃ£o

  // ClassificaÃ§Ã£o de risco
  riskLevel   AuditRiskLevel @default(LOW)
  containsPII Boolean        @default(false) // ContÃ©m dados pessoais
  isSensitive Boolean        @default(false) // ContÃ©m dados sensÃ­veis

  // Relacionamentos
  userId         String? // UsuÃ¡rio que realizou a aÃ§Ã£o
  user           User?         @relation(fields: [userId], references: [id])
  organizationId String? // OrganizaÃ§Ã£o relacionada
  organization   Organization? @relation(fields: [organizationId], references: [id])

  // Timestamps
  timestamp DateTime @default(now()) // Quando ocorreu
  createdAt DateTime @default(now())

  // Ã�ndiices para performance
  @@index([userId])
  @@index([organizationId])
  @@index([action])
  @@index([timestamp])
  @@index([riskLevel])
  @@index([entityType, entityId])
}

// ============================================
// POLÃ�TICAS DE RLS (ROW LEVEL SECURITY)
// ============================================

// ConfiguraÃ§Ãµes de RLS para suporte multi-tenant
// Estas polÃ­ticas devem ser aplicadas no banco de dados PostgreSQL

// PolÃ­tica para Organization: Acessar apenas dados da organizaÃ§Ã£o do usuÃ¡rio
// CREATE POLICY "Organization is tenant" ON Organization
//   FOR ALL TO authenticated
//   USING (organization_id = auth.jwt()->>'organizationId');

// PolÃ­tica para User: Acessar apenas usuÃ¡rios da mesma organizaÃ§Ã£o
// CREATE POLICY "User is tenant" ON User
//   FOR ALL TO authenticated
//   USING (organization_id = auth.jwt()->>'organizationId');

// PolÃ­tica para Property: Acessar apenas imÃ³veis da organizaÃ§Ã£o
// CREATE POLICY "Property is tenant" ON Property
//   FOR ALL TO authenticated
//   USING (organization_id = auth.jwt()->>'organizationId');

// PolÃ­tica para Lead: Acessar apenas leads da organizaÃ§Ã£o
// CREATE POLICY "Lead is tenant" ON Lead
//   FOR ALL TO authenticated
//   USING (organization_id = auth.jwt()->>'organizationId');

// PolÃ­tica para Notification: Acessar apenas notificaÃ§Ãµes do usuÃ¡rio
// CREATE POLICY "Notification is user" ON Notification
//   FOR ALL TO authenticated
//   USING (user_id = auth.jwt()->>'userId');

// PolÃ­tica de permissÃµes baseadas no papel do usuÃ¡rio
// CREATE POLICY "User can access own data" ON User
//   FOR SELECT TO authenticated
//   USING (id = auth.jwt()->>'userId' OR role = 'ADMIN');


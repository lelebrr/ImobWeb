/// Modelo de UsuÃ¡rios do Sistema (Corretores, Gerentes, Admin)
model User {
  id             String       @id @default(cuid())
  name           String // Nome completo do usuÃ¡rio
  email          String       @unique // Email Ãºnico para login
  phone          String? // Telefone de contato
  whatsapp       String? // WhatsApp para contato profissional
  password       String // Senha criptografada
  role           UserRole // Papel do usuÃ¡rio no sistema
  permissions    Json? // Overrides de permissão por usuário (ex: { "denied": ["billing:view"] })
  status         EntityStatus @default(ATIVO) // Status do usuÃ¡rio
  lastLogin      DateTime? // Ãšltimo login do usuÃ¡rio
  avatar         String? // URL do avatar do usuÃ¡rio
  bio            String? // Biografia ou descriÃ§Ã£o do usuÃ¡rio
  department     String? // Departamento ou Ã¡rea de atuaÃ§Ã£o
  specialization String? // EspecializaÃ§Ã£o do usuÃ¡rio
  createdAt      DateTime     @default(now()) // Data de criaÃ§Ã£o
  updatedAt      DateTime     @updatedAt // Data de atualizaÃ§Ã£o

  // Relacionamentos
  organizationId String // Chave estrangeira para multi-tenant
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // Relacionamentos com entidades principais
  properties         Property[] // ImÃ³veis criados/gerenciados pelo usuÃ¡rio
  leads              Lead[] // Leads atribuÃ­dos ao usuÃ¡rio
  conversations      Conversation[] // Conversas do usuÃ¡rio
  notifications      Notification[] // NotificaÃ§Ãµes do usuÃ¡rio
  assignedLeads      Lead[]               @relation("AssignedLeads") // Leads atribuÃ­dos explicitamente
  auditLogs          AuditLog[]
  communicationUsage CommunicationUsage[]
  onboardingProgress OnboardingProgress?

  // ComentÃ¡rios
  /// UsuÃ¡rio do sistema com diferentes nÃ­veis de permissÃ£o
  /// Suporta multi-tenant atravÃ©s da organizaÃ§Ã£o
  propertyVersions PropertyVersion[]
  vistorias        Vistoria[]

  // Ã�ndices
  @@index([organizationId])
  @@index([email])
  @@index([phone])
  @@index([whatsapp])
}

/// Modelo de OrganizaÃ§Ãµes (Multi-tenant - ImobiliÃ¡rias)
model Organization {
  id             String       @id @default(cuid())
  name           String // Nome da imobiliÃ¡ria
  cnpj           String?      @unique // CNPJ Ãºnico
  phone          String? // Telefone principal
  email          String?      @unique // Email corporativo
  website        String? // Website da imobiliÃ¡ria
  logo           String? // URL do logo da empresa
  address        String? // EndereÃ§o completo
  neighborhood   String? // Bairro
  city           String? // Cidade
  state          String? // Estado
  cep            String? // CEP
  country        String?      @default("Brasil") // PaÃ­s
  status         EntityStatus @default(ATIVO) // Status da organizaÃ§Ã£o
  planType       PackageType? // Tipo de plano atual
  maxUsers       Int? // Limite de usuÃ¡rios
  maxProperties  Int? // Limite de imÃ³veis
  maxLeads       Int? // Limite de leads
  features       Json? // Recursos disponÃ­veis no plano
  settings       Json? // ConfiguraÃ§Ãµes personalizadas
  primaryColor   String? // Cor primÃ¡ria da marca (White Label)
  secondaryColor String? // Cor secundÃ¡ria da marca (White Label)
  isPlatform     Boolean      @default(false) // Indica se é a organização gestora (ImobWeb)
  roleQuotas     Json? // Limites de usuários por papel (ex: {"AGENCY_SALES": 10})
  subDomain      String?      @unique // SubdomÃ­nio exclusivo da imobiliÃ¡ria
  createdAt      DateTime     @default(now()) // Data de criaÃ§Ã£o
  updatedAt      DateTime     @updatedAt // Data de atualizaÃ§Ã£o

  // Relacionamentos
  users              User[] // UsuÃ¡rios da organizaÃ§Ã£o
  properties         Property[] // ImÃ³veis da organizaÃ§Ã£o
  leads              Lead[] // Leads da organizaÃ§Ã£o
  subscriptions      Subscription[] // Assinaturas da organizaÃ§Ã£o
  apiKeys            ApiKey[] // Chaves de API da organizaÃ§Ã£o
  auditLogs          AuditLog[]
  contracts          Contract[] // Contratos da organizaÃ§Ã£o
  portalIntegrations PortalIntegration[] // IntegraÃ§Ãµes com portais
  communicationUsage CommunicationUsage[]
  communicationQuota CommunicationQuota[]
  integrationEvents  IntegrationEvent[]
  autoBlockConfigs   AutoBlockConfig[]
  onboardingProgresses OnboardingProgress[]
  adoptionMetrics      AdoptionMetrics[]
  resellerClient       ResellerClient?
  vistorias            Vistoria[]

  // ComentÃ¡rios
  /// OrganizaÃ§Ã£o principal para suporte multi-tenant
  /// Cada organizaÃ§Ã£o representa uma imobiliÃ¡ria diferente

  // Ã�ndices
  @@index([cnpj])
  @@index([email])
  @@index([city])
}


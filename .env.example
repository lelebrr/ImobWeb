# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# Database (Supabase PostgreSQL)
DATABASE_URL=postgres://user:password@host:port/dbname?sslmode=require

# NextAuth Configuration
NEXTAUTH_URL=https://your-domain.vercel.app
NEXTAUTH_SECRET=generate-a-strong-random-secret-here

# App Settings
NEXT_PUBLIC_APP_URL=https://your-domain.vercel.app
ALLOWED_ORIGINS=https://your-domain.vercel.app

# Encryption (REQUIRED - generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
ENCRYPTION_KEY=your-32-character-minimum-encryption-key-here
ENCRYPTION_SALT=your-unique-salt-here

# WhatsApp Business API
WHATSAPP_VERIFY_TOKEN=your-whatsapp-verify-token-here
WHATSAPP_APP_SECRET=your-whatsapp-app-secret-here

# Stripe
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret
